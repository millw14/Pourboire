# Copy to .env.local and fill in. Every variable the code reads is listed here —
# the previous version of this file listed Web3Auth keys the app never used and
# omitted PRIVY_APP_SECRET, CRON_SECRET and the Twitter access tokens, all of
# which are required.

# ---------------------------------------------------------------- database
# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/pourboire

# -------------------------------------------------------------- encryption
# 32 bytes of hex (64 characters) wrapping every custodial private key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this makes every custodial wallet permanently unspendable. Back it up
# somewhere other than the machine running the app.
ENCRYPTION_KEY=

# -------------------------------------------------------------------- auth
# https://dashboard.privy.io — App ID is public, the secret is not.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ------------------------------------------------------------------ solana
# Which cluster this deployment operates on. Drives the wallet adapter, the
# server RPC and the explorer links from one value, so the browser can never
# think it is on devnet while the server signs mainnet transfers.
# One of: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional. Defaults to the public endpoint for the cluster above, which is
# heavily rate limited and will return 403s under any real traffic — use a
# provider (Helius, QuickNode, Triton) in production.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ----------------------------------------------------------------- twitter
# https://developer.x.com — the bot account's own credentials. All four are
# required: the first two authenticate the app, the second two let it post as
# @Pourboireonsol.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ------------------------------------------------------------------- cron
# Bearer token protecting POST /api/twitter/poll, which signs transfers out of
# user wallets. If this is unset the endpoint refuses every request rather than
# defaulting to open.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ------------------------------------------------------------------- misc
# Public origin. Only needed if VERCEL_URL is not set.
NEXT_PUBLIC_BASE_URL=
