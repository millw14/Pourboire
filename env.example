# Copy to .env.local and fill in. Every variable the code reads is listed here —
# the previous version of this file listed Web3Auth keys the app never used and
# omitted PRIVY_APP_SECRET, CRON_SECRET and the Twitter access tokens, all of
# which are required.

# ---------------------------------------------------------------- database
# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/pourboire

# -------------------------------------------------------------- encryption
# 32 bytes of hex (64 characters) wrapping every custodial private key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this makes every custodial wallet permanently unspendable. Back it up
# somewhere other than the machine running the app.
ENCRYPTION_KEY=

# -------------------------------------------------------------------- auth
# https://dashboard.privy.io — App ID is public, the secret is not.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ------------------------------------------------------------------- chain
# Which Robinhood Chain network to operate on: mainnet | testnet
# Defaults to testnet, so a misconfigured deployment moves play money.
NEXT_PUBLIC_CHAIN_NETWORK=testnet

# Optional. Defaults to the public endpoint for the network above. The public
# RPC is fine for light use but will rate limit under real traffic.
#   mainnet: https://rpc.mainnet.chain.robinhood.com  (chain id 4663)
#   testnet: https://rpc.testnet.chain.robinhood.com  (chain id 46630)
NEXT_PUBLIC_CHAIN_RPC_URL=

# ----------------------------------------------------------------- twitter
# https://developer.x.com — the bot account's own credentials. All four are
# required: the first two authenticate the app, the second two let it post as
# @Pourboireonsol.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ------------------------------------------------------------------- cron
# Bearer token protecting POST /api/twitter/poll, which signs transfers out of
# user wallets. If this is unset the endpoint refuses every request rather than
# defaulting to open.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ------------------------------------------------------------------- misc
# Public origin. Needed for receipt card rendering and verification links.
# Only optional if VERCEL_URL is set.
NEXT_PUBLIC_BASE_URL=
